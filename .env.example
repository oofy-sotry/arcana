# docker compose용 — cp .env.example .env 후 값을 채운다 (.env는 커밋하지 않음)

# 서버 JWT 서명 키 — 아무 긴 랜덤 값 (예: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# 데스크톱 에이전트가 게이트웨이에 보낼 토큰(16자 이상). 데스크톱은 agent-secrets.json의 gatewayToken에 같은 값
ARCANA_GATEWAY_TOKEN=

# 큰 모델(Gemini) 키 — 비우면 게이트웨이·워커는 뜨지만 Gemini 요청은 503/실패
GEMINI_API_KEY=

# 이미지 태그 (latest 또는 sha-<커밋 7자리>)
# ARCANA_IMAGE_TAG=latest

# 이 VM의 기존 서버 DB를 그대로 쓰려면
# SERVER_DATA_DIR=./apps/server/data

# 게이트웨이를 다른 PC에서도 쓰려면 0.0.0.0 (기본 127.0.0.1)
# GATEWAY_BIND=127.0.0.1
