{
  "name": "desktop",
  "productName": "arcana",
  "version": "0.2.3",
  "description": "Arcana — Desktop Pet RPG",
  "main": "src/main/index.js",
  "author": "oofy-sotry",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test"
  },
  "dependencies": {
    "@arcana/agent": "workspace:*",
    "@arcana/game-core": "workspace:*",
    "electron-updater": "^6.8.9",
    "pixi.js": "^8.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@arcana/shared": "workspace:*",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.oofy-sotry.arcana",
    "productName": "Arcana",
    "extraMetadata": {
      "name": "arcana"
    },
    "publish": {
      "provider": "github",
      "owner": "oofy-sotry",
      "repo": "arcana"
    },
    "files": [
      "**/*",
      "!test/**",
      "!**/.turbo/**",
      "!packages/agent/{src,scripts,bench}/**",
      "!packages/agent/tsconfig.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  }
}
